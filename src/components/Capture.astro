---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { id: string; language: 'de' | 'en'; alt: string; caption: string; }
const { id, language, alt, caption } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/captures/**/*.png', { eager: true });
const source = files[`../assets/captures/${language}/${id}.png`]?.default;
if (!source) throw new Error(`Reviewed screenshot missing: ${language}/${id}`);
const open = language === 'de' ? 'Originalbild öffnen' : 'Open original image';
---
<figure class="e2-capture">
  <a href={source.src} target="_blank" rel="noopener" aria-label={`${alt} – ${open}`}>
    <Image src={source} alt={alt} widths={[640, 960, 1280]} sizes="(min-width: 72rem) 52rem, 100vw" format="webp" quality={90} loading="lazy" />
  </a>
  <figcaption>{caption} <a href={source.src} target="_blank" rel="noopener">{open} ↗</a></figcaption>
</figure>
<style>
  .e2-capture { margin: 1.5rem 0 2rem; }
  .e2-capture > a { display: block; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; overflow: hidden; background: #101010; }
  .e2-capture img { display: block; width: 100%; height: auto; margin: 0; }
  .e2-capture figcaption { margin-top: .65rem; font-size: .875rem; line-height: 1.6; color: var(--sl-color-gray-2); }
  .e2-capture figcaption a { margin-inline-start: .4rem; white-space: nowrap; }
</style>
