---
import api from '../../data/skin-api.json';
interface Props { kind: 'attributes' | 'functions' | 'classes' | 'components'; }
const { kind } = Astro.props;
const entries = api[kind];
const sourceURL = (path: string, line: number) => `${api.repository}/blob/${api.revision}/${path}#L${line}`;
const count = entries.length;
---
<section class="skin-api" data-skin-api>
  <div class="api-search" data-pagefind-ignore>
    <label for={`skin-filter-${kind}`}>Filter {kind} by name, meaning or native method</label>
    <input id={`skin-filter-${kind}`} type="search" placeholder="For example: alpha, font, position…" autocomplete="off" data-skin-filter />
    <p data-skin-count role="status" aria-live="polite">{count} entries</p>
  </div>
  <p class="api-version">Source snapshot: <a href={sourceURL(api.path, 1)}>skin.py @ {api.revision.slice(0, 10)}</a>. The catalogue lists source capabilities; support also depends on the receiver build and native widget class.</p>
  <div class="api-entries">
    {entries.map((entry: any) => (
      <section class="api-entry" id={`${kind}-${entry.category ? entry.category + '-' : ''}${entry.name}`} data-skin-entry>
        <h3><a href={`#${kind}-${entry.category ? entry.category + '-' : ''}${entry.name}`}><code translate="no">{entry.name}</code></a></h3>
        {entry.group && <p class="api-group">{entry.group}{entry.deprecated ? ' · deprecated alias' : ''}{entry.no_op ? ' · no action in AttributeParser' : ''}</p>}
        {entry.summary && <p>{entry.summary}</p>}
        {kind === 'components' && <p>{entry.category} module. Extends <code translate="no">{entry.bases.join(', ')}</code>. {entry.properties.length ? <>Properties declared here: <code translate="no">{entry.properties.join(', ')}</code>.</> : 'Properties may be supplied by its base class or methods.'} A file in the source tree does not automatically create a source in every screen.</p>}
        {kind === 'functions' && <pre translate="no"><code>{entry.signature}</code></pre>}
        {entry.native_calls?.length > 0 && <p>Native target must provide: <code translate="no">{entry.native_calls.join(', ')}</code>.</p>}
        {entry.alias && <p>Delegates to <a href={`#attributes-${entry.alias}`}><code translate="no">{entry.alias}</code></a>.</p>}
        {entry.parsers?.length > 0 && <p>Value parsers: {entry.parsers.map((name: string, i: number) => <>{i ? ', ' : ''}<a href={`../functions/#functions-${name}`}><code translate="no">{name}</code></a></>)}.</p>}
        {entry.tokens?.length > 0 && <p>Tokens found in the parser: <code translate="no">{entry.tokens.join(', ')}</code>. These can belong to different sub-options; use the syntax explained above.</p>}
        {kind === 'classes' && <details><summary>Methods defined in this class ({entry.methods.length})</summary><ul>{entry.methods.map((method: any) => <li><a href={sourceURL(api.path, method.line)}><code translate="no">{method.signature}</code></a>{method.doc ? ` — ${method.doc}` : ''}</li>)}</ul></details>}
        <p class="api-source"><a href={sourceURL(entry.path || api.path, entry.line)}>Read the implementation at line {entry.line} ↗</a></p>
      </section>
    ))}
  </div>
  <p data-skin-empty hidden>No matching entry. Clear the filter or search the whole handbook above.</p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-skin-api]').forEach(root => {
    const input = root.querySelector<HTMLInputElement>('[data-skin-filter]')!;
    const entries = [...root.querySelectorAll<HTMLElement>('[data-skin-entry]')];
    const texts = entries.map(entry => entry.textContent?.toLocaleLowerCase() || '');
    const update = () => {
      const words = input.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      entries.forEach((entry, index) => { entry.hidden = !words.every(word => texts[index].includes(word)); if (!entry.hidden) visible++; });
      root.querySelector('[data-skin-count]')!.textContent = `${visible} of ${entries.length} entries`;
      (root.querySelector('[data-skin-empty]') as HTMLElement).hidden = visible !== 0;
    };
    input.addEventListener('input', update);
    // A deep link must remain visible after a local filter was used.
    window.addEventListener('hashchange', () => { input.value = ''; update(); });
  });
</script>
<style>
  .api-search { position: relative; padding: 1rem; background: var(--sl-color-bg-sidebar); border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; }
  label { display: block; font-weight: 600; }
  input { box-sizing: border-box; margin-top: .5rem; width: 100%; padding: .65rem; background: var(--sl-color-bg); color: var(--sl-color-text); border: 1px solid var(--sl-color-gray-3); border-radius: .3rem; font: inherit; }
  .api-search p, .api-version, .api-source, .api-group { font-size: .875rem; }
  .api-entry { margin-top: 1.5rem; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; scroll-margin-top: 6rem; }
  .api-entry[hidden], [data-skin-empty][hidden] { display: none; }
  .api-entry h3 { margin-top: 0; }
  .api-entry p { margin-block: .7rem; }
  pre { overflow-x: auto; max-width: 100%; font-size: .85rem; }
  code { overflow-wrap: anywhere; }
</style>
