---
import Footer from '@astrojs/starlight/components/Footer.astro';
const de = Astro.locals.starlightRoute.locale === 'de';
const heading = de ? 'OpenATV – Links und Downloads' : 'OpenATV – links and downloads';
const links = [
  { href: 'https://www.opena.tv/index.php', title: de ? 'OpenATV-Forum' : 'OpenATV forum', text: de ? 'Support und Austausch' : 'Support and community' },
  { href: 'https://github.com/openatv/enigma2', title: 'Enigma2 Git', text: de ? 'OpenATV-Bedienoberfläche' : 'OpenATV user interface' },
  { href: 'https://github.com/oe-alliance/oe-alliance-core', title: 'OE-Alliance Git', text: de ? 'Image-Buildsystem' : 'Image build system' },
  { href: 'https://github.com/oe-alliance-plugins', title: de ? 'Plugin-Repositories' : 'Plugin repositories', text: de ? 'Erweiterungen auf GitHub' : 'Extensions on GitHub' },
  { href: 'https://github.com/oe-alliance-drivers', title: de ? 'WLAN-Treiber Git' : 'Wi-Fi drivers Git', text: de ? 'Treiber-Repositories' : 'Driver repositories' },
  { href: 'https://images.mynonpublic.com/openatv/index.php', title: de ? 'Image-Downloads' : 'Image downloads', text: de ? 'OpenATV-Images nach Modell' : 'OpenATV images by model' },
];
---
<Footer {...Astro.props} />
<nav class="project-links" aria-label={heading} data-pagefind-ignore>
  <p class="links-title">{heading}</p>
  <ul>
    {links.map(({ href, title, text }) => <li><a href={href}><strong>{title} <span aria-hidden="true">↗</span></strong><span>{text}</span></a></li>)}
  </ul>
</nav>
<style>
  .project-links { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--sl-color-hairline-light); }
  .links-title { margin: 0 0 .75rem; font-weight: 600; color: var(--sl-color-white); }
  ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: .75rem; list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }
  a { display: block; height: 100%; padding: .75rem; border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; text-decoration: none; }
  a:hover { border-color: var(--sl-color-text-accent); background: var(--sl-color-bg-nav); }
  strong { display: block; color: var(--sl-color-text-accent); font-size: .9rem; }
  a > span { display: block; margin-top: .2rem; font-size: .8rem; color: var(--sl-color-gray-2); }
  a:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
</style>
