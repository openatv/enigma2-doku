---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { id: string; language: 'de' | 'en'; alt: string; caption: string; crop?: number[]; }
const { id, language, alt, caption, crop = [0, 0, 0, 0] } = Astro.props;
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/umbra/*.png', { eager: true });
const source = sources[`../assets/umbra/${id}.png`]?.default;
if (!source) throw new Error(`Manual image missing: ${id}`);
const [left, top, right, bottom] = crop;
const width = 1 - left - right;
const height = 1 - top - bottom;
const open = language === 'de' ? 'Originalbild öffnen' : 'Open original image';
const frame = `aspect-ratio:${source.width * width}/${source.height * height}`;
const positioning = `width:${100 / width}%;max-width:none;left:${-100 * left / width}%;top:${-100 * top / height}%`;
---
<figure>
  <a class="image-frame" style={frame} href={source.src} target="_blank" rel="noopener" aria-label={`${alt} – ${open}`}>
    <Image src={source} style={positioning} alt={alt} widths={[640, 960, 1280]} sizes="(min-width: 72rem) 52rem, 100vw" format="webp" quality={90} loading="lazy" />
  </a>
  <figcaption>{caption} <a href={source.src} target="_blank" rel="noopener">{open} ↗</a></figcaption>
</figure>
<style>
  figure { margin: 1.5rem 0 2rem; }
  .image-frame { display:block; position:relative; overflow:hidden; border:1px solid var(--sl-color-gray-5); border-radius:.5rem; background:#101010; }
  .image-frame img { display:block; position:absolute; height:auto; margin:0; }
  figcaption { margin-top:.65rem; font-size:.875rem; line-height:1.6; color:var(--sl-color-gray-2); }
  figcaption a { margin-inline-start:.4rem; white-space:nowrap; }
</style>
